<%- include('../partials/head', { title: 'Admin panel' }) %>
<%- include('../partials/nav', { active: 'admin' }) %>

<div class="page-header">
  <div class="page-header__text">
    <span class="eyebrow">Administration</span>
    <h1>Control panel</h1>
    <p class="page-subtitle">
      Every record the portal holds, and the four actions reserved for an administrator:
      assigning roles, triaging applications, recording donations, and removing accounts.
    </p>
  </div>
  <div class="page-header__actions">
    <a class="btn btn--secondary" href="/users">Alumni directory</a>
    <a class="btn btn--primary" href="/admin/users">Manage roles</a>
  </div>
</div>

<%- include('_tabs', { tab: 'overview' }) %>

<% if (notice) { %>
  <div class="alert alert--success" role="status"><%= notice %></div>
<% } %>
<% if (error) { %>
  <div class="alert alert--danger" role="alert"><%= error %></div>
<% } %>

<div class="stat-grid">
  <div class="stat">
    <span class="stat__label">Users</span>
    <span class="stat__value"><%= counts.users %></span>
    <span class="stat__meta"><a href="/admin/users">Roles and accounts</a></span>
  </div>
  <div class="stat">
    <span class="stat__label">Donations</span>
    <span class="stat__value"><%= counts.totalDonations.toLocaleString('en-US') %></span>
    <span class="stat__meta"><%= counts.donations %> records, all currencies summed</span>
  </div>
  <div class="stat">
    <span class="stat__label">Job postings</span>
    <span class="stat__value"><%= counts.postings %></span>
    <span class="stat__meta"><%= openPostings %> still open</span>
  </div>
  <div class="stat">
    <span class="stat__label">Applications</span>
    <span class="stat__value"><%= counts.applications %></span>
    <span class="stat__meta"><%= pendingApplications %> awaiting review</span>
  </div>
</div>

<section class="card">
  <div class="section-head">
    <h2>Accounts by role</h2>
    <span class="section-head__meta">The matrix these roles carry is in ddd.md section 8</span>
  </div>
  <div class="table-wrap">
    <table class="data">
      <thead>
        <tr>
          <th scope="col">Role</th>
          <th scope="col">Accounts</th>
          <th scope="col">Can do</th>
        </tr>
      </thead>
      <tbody>
        <% byRole.forEach((entry) => { %>
          <tr>
            <td><span class="pill pill--<%= entry.role %>"><%= entry.role %></span></td>
            <td class="num"><%= entry.total %></td>
            <td>
              <% if (entry.role === 'admin') { %>
                Everything, plus assigning roles and deleting accounts
              <% } else if (entry.role === 'staff') { %>
                Directory, announcements, postings, donations, applications
              <% } else if (entry.role === 'employer') { %>
                Partner company contact; posting writes are still refused (no owner column)
              <% } else { %>
                Read the directory and announcements, apply to postings
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</section>

<section class="card">
  <div class="section-head">
    <h2>Latest applications</h2>
    <a class="section-head__meta" href="/admin/applications">All applications</a>
  </div>
  <% if (recentApplications.length === 0) { %>
    <p class="card__meta">No applications yet.</p>
  <% } else { %>
    <div class="table-wrap">
      <table class="data">
        <thead>
          <tr>
            <th scope="col">Id</th>
            <th scope="col">Applicant</th>
            <th scope="col">Posting</th>
            <th scope="col">Applied</th>
            <th scope="col">Status</th>
          </tr>
        </thead>
        <tbody>
          <% recentApplications.forEach((application) => { %>
            <tr>
              <td class="num"><%= application.id %></td>
              <td><a href="/users/<%= application.userId %>"><%= application.applicantUsername %></a></td>
              <td><a href="/job-postings/<%= application.jobPostingId %>"><%= application.jobTitle %></a></td>
              <td class="num"><%= formatDate(application.createdAt) %></td>
              <td><span class="pill pill--<%= application.status %>"><%= application.status %></span></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<section class="card">
  <div class="section-head">
    <h2>Latest donations</h2>
    <a class="section-head__meta" href="/admin/donations">Record and edit</a>
  </div>
  <% if (recentDonations.length === 0) { %>
    <p class="card__meta">No donations yet.</p>
  <% } else { %>
    <div class="table-wrap">
      <table class="data">
        <thead>
          <tr>
            <th scope="col">Id</th>
            <th scope="col">Donor</th>
            <th scope="col">Amount</th>
            <th scope="col">Campaign</th>
            <th scope="col">Status</th>
          </tr>
        </thead>
        <tbody>
          <% recentDonations.forEach((donation) => { %>
            <tr>
              <td class="num"><%= donation.id %></td>
              <td><a href="/users/<%= donation.userId %>"><%= donation.donorUsername %></a></td>
              <td class="num"><%= donation.amount.toLocaleString('en-US') %> <%= donation.currency %></td>
              <td><%= donation.campaign || '—' %></td>
              <td><span class="pill pill--<%= donation.status === 'completed' ? 'accepted' : donation.status %>"><%= donation.status %></span></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<%- include('../partials/footer') %>
