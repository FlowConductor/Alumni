<%- include('../partials/head', { title: posting.title }) %>
<%- include('../partials/nav', { active: 'job-postings' }) %>

<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="/job-postings">Job postings</a><span>/</span><%= posting.title %>
</nav>

<div class="page-header">
  <div class="page-header__text">
    <span class="eyebrow">Career services</span>
    <h1><%= posting.title %></h1>
    <p class="page-subtitle">
      <%= posting.company %><% if (posting.location) { %> · <%= posting.location %><% } %>
      · Posted by <%= posting.postedByUsername || 'Company' %>
    </p>
  </div>
  <div class="page-header__actions">
    <span class="pill pill--<%= posting.status %>"><%= posting.status %></span>
  </div>
</div>

<div class="detail-grid">
  <div class="detail-main">
    <div class="card">
      <h2 class="card__title">About the role</h2>
      <% if (posting.description) { %>
        <div class="article__body"><%= posting.description %></div>
      <% } else { %>
        <p class="card__meta">
          No description was provided for this posting. Contact the poster for details.
        </p>
      <% } %>
    </div>

    <div class="card">
      <div class="section-head">
        <h2>Applications</h2>
        <span class="section-head__meta"><%= applications.length %> on record</span>
      </div>

      <% if (applications.length === 0) { %>
        <div class="empty-state">
          <p>No applications yet. Applications appear here as alumni apply.</p>
        </div>
      <% } else { %>
        <div class="table-wrap">
          <table class="data">
            <caption>Applicants, newest first</caption>
            <thead>
              <tr>
                <th scope="col">Id</th>
                <th scope="col">Applicant</th>
                <th scope="col">Status</th>
                <th scope="col">Cover letter</th>
                <th scope="col">Applied</th>
              </tr>
            </thead>
            <tbody>
              <% applications.forEach((application) => { %>
                <tr>
                  <td class="num"><%= application.id %></td>
                  <td>
                    <a href="/users/<%= application.userId %>"><%= application.applicantUsername %></a>
                  </td>
                  <td><span class="pill pill--<%= application.status %>"><%= application.status %></span></td>
                  <td class="truncate"><%= application.coverLetter || '—' %></td>
                  <td class="num"><%= formatDate(application.createdAt) %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <% if (canApply) { %>
    <div class="card">
      <h2 class="card__title">Apply to this posting</h2>
      <p class="card__meta">
        Applications are recorded against your directory entry, once per posting.
      </p>
      <form method="POST" action="/job-postings/<%= posting.id %>/apply">
        <div class="field">
          <label for="user_id">Your user id <span class="required">(required)</span></label>
          <input type="number" id="user_id" name="user_id" min="1" required>
          <p class="hint">The id of your record in the alumni directory.</p>
        </div>
        <div class="field">
          <label for="cover_letter">Cover letter <span class="required">(optional)</span></label>
          <textarea id="cover_letter" name="cover_letter" rows="4"></textarea>
        </div>
        <div class="form-actions">
          <button class="btn btn--primary" type="submit">Apply</button>
        </div>
      </form>
    </div>
    <% } else if (!currentUser) { %>
    <div class="card">
      <h2 class="card__title">Apply to this posting</h2>
      <p class="card__meta">
        <a href="/login?next=%2Fjob-postings%2F<%= posting.id %>">Sign in</a> as an alumni member to
        apply. Accounts created before registration existed have no password.
      </p>
    </div>
    <% } %>
  </div>

  <aside class="detail-side">
    <div class="card">
      <h2 class="card__title">Details</h2>
      <dl class="definition-list">
        <div>
          <dt>Record id</dt>
          <dd><%= posting.id %></dd>
        </div>
        <div>
          <dt>Company</dt>
          <dd><%= posting.company %></dd>
        </div>
        <div>
          <dt>City</dt>
          <dd><%= posting.location || '—' %></dd>
        </div>
        <div>
          <dt>Status</dt>
          <dd><span class="pill pill--<%= posting.status %>"><%= posting.status %></span></dd>
        </div>
        <div>
          <dt>Posted by</dt>
          <dd><%= posting.postedByUsername || 'Company' %></dd>
        </div>
        <div>
          <dt>Created</dt>
          <dd><%= formatDate(posting.createdAt) %></dd>
        </div>
      </dl>
    </div>

    <% if (canManage) { %>
    <div class="card">
      <h2 class="card__title">Actions</h2>
      <div class="card__footer">
        <a class="btn btn--primary" href="/job-postings/<%= posting.id %>/edit">Edit posting</a>
      </div>
      <div class="card__footer">
        <form method="POST" action="/job-postings/<%= posting.id %>/delete"
              onsubmit="return confirm('Delete this job posting? This cannot be undone.');">
          <button class="btn btn--danger btn--small" type="submit">Delete</button>
        </form>
        <a class="btn btn--link" href="/api/job-postings/<%= posting.id %>">JSON record</a>
      </div>
    </div>
    <% } %>

    <div class="card">
      <h2 class="card__title">Related records</h2>
      <dl class="definition-list">
        <div>
          <dt>Applications</dt>
          <dd><a href="/api/job-postings/<%= posting.id %>/applications">JSON</a></dd>
        </div>
        <div>
          <dt>All postings</dt>
          <dd><a href="/api/job-postings">JSON</a></dd>
        </div>
      </dl>
    </div>
  </aside>
</div>

<%- include('../partials/footer') %>
