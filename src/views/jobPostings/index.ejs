<%- include('../partials/head', { title: 'Job postings' }) %>
<%- include('../partials/nav', { active: 'job-postings' }) %>

<div class="page-header">
  <div class="page-header__text">
    <span class="eyebrow">Career services</span>
    <h1>Job postings<span class="count-badge"><%= postings.length %></span></h1>
    <p class="page-subtitle">
      Opportunities shared by alumni and partner companies. Open postings accept applications.
    </p>
  </div>
  <div class="page-header__actions">
    <% if (canManage) { %>
      <a class="btn btn--primary" href="/job-postings/new">New posting</a>
    <% } %>
  </div>
</div>

<% if (postings.length === 0) { %>
  <div class="empty-state">
    <p>No job postings yet. Be the first to share one.</p>
    <a class="btn btn--secondary" href="/job-postings/new">Create a posting</a>
  </div>
<% } else { %>
  <div class="table-wrap">
    <table class="data">
      <caption><%= postings.length %> postings, ordered by id</caption>
      <thead>
        <tr>
          <th scope="col">Id</th>
          <th scope="col">Title</th>
          <th scope="col">Company</th>
          <th scope="col">City</th>
          <th scope="col">Status</th>
          <th scope="col">Posted by</th>
          <th scope="col">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% postings.forEach((posting) => { %>
          <tr>
            <td class="num"><%= posting.id %></td>
            <td><a href="/job-postings/<%= posting.id %>"><%= posting.title %></a></td>
            <td><%= posting.company %></td>
            <td><%= posting.location || '—' %></td>
            <td><span class="pill pill--<%= posting.status %>"><%= posting.status %></span></td>
            <td><%= posting.postedByUsername || 'Company' %></td>
            <td>
              <div class="actions">
                <a class="btn btn--link" href="/job-postings/<%= posting.id %>">View</a>
                <% if (canManage) { %>
                  <a class="btn btn--link" href="/job-postings/<%= posting.id %>/edit">Edit</a>
                  <form method="POST" action="/job-postings/<%= posting.id %>/delete"
                        onsubmit="return confirm('Delete this job posting? This cannot be undone.');">
                    <button class="btn btn--link btn--link-danger" type="submit">Delete</button>
                  </form>
                <% } %>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('../partials/footer') %>
