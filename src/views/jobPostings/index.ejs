<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Job Postings - MIS Alumni Portal</title>
</head>
<body>
  <h1>Job Postings</h1>
  <p><a href="/job-postings/new">New posting</a></p>
  <table border="1" cellpadding="6">
    <thead><tr><th>Id</th><th>Title</th><th>Company</th><th>Location</th><th>Status</th><th>Posted By</th><th>Actions</th></tr></thead>
    <tbody>
      <% postings.forEach((posting) => { %>
      <tr>
        <td><%= posting.id %></td>
        <td><%= posting.title %></td>
        <td><%= posting.company %></td>
        <td><%= posting.location || '-' %></td>
        <td><%= posting.status %></td>
        <td><%= posting.postedByUsername || 'Company' %></td>
        <td>
          <a href="/job-postings/<%= posting.id %>">view</a> |
          <a href="/job-postings/<%= posting.id %>/edit">edit</a> |
          <form method="POST" action="/job-postings/<%= posting.id %>/delete" style="display:inline">
            <button type="submit">delete</button>
          </form>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
  <p><a href="/">Back</a></p>
</body>
</html>
