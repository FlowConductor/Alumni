<%- include('../partials/head', { title: 'New job posting' }) %>
<%- include('../partials/nav', { active: 'job-postings' }) %>

<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="/job-postings">Job postings</a><span>/</span>New posting
</nav>

<div class="page-header">
  <div class="page-header__text">
    <span class="eyebrow">Career services</span>
    <h1>New job posting</h1>
    <p class="page-subtitle">
      Title and company are required. City and description are optional.
    </p>
  </div>
</div>

<form class="form" method="POST" action="/job-postings">
  <fieldset>
    <legend>The role</legend>

    <div class="field">
      <label for="title">Title <span class="required">(required, max 120 characters)</span></label>
      <input type="text" id="title" name="title" maxlength="120" required autocomplete="off">
      <p class="hint">The job title as the company writes it, for example "Data Analyst".</p>
    </div>

    <div class="field">
      <label for="company">Company <span class="required">(required)</span></label>
      <input type="text" id="company" name="company" required autocomplete="off">
    </div>

    <div class="field">
      <label for="location">City <span class="required">(optional)</span></label>
      <input type="text" id="location" name="location" autocomplete="off">
    </div>

    <div class="field">
      <label for="description">Description <span class="required">(optional)</span></label>
      <textarea id="description" name="description" rows="8"></textarea>
      <p class="hint">Responsibilities, requirements, and how to get in touch.</p>
    </div>
  </fieldset>

  <fieldset>
    <legend>Publishing</legend>

    <div class="field">
      <label for="posted_by">Posted by (user id) <span class="required">(optional)</span></label>
      <input type="number" id="posted_by" name="posted_by" min="1">
      <p class="hint">Leave empty for a partner company posting without a portal account.</p>
    </div>

    <div class="field">
      <label for="status">Status</label>
      <select id="status" name="status">
        <option value="open">open — accepting applications</option>
        <option value="closed">closed — no longer accepting</option>
      </select>
    </div>
  </fieldset>

  <div class="form-actions">
    <button class="btn btn--primary" type="submit">Create posting</button>
    <a class="btn btn--secondary" href="/job-postings">Cancel</a>
  </div>
</form>

<%- include('../partials/footer') %>
