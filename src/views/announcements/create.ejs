<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>New Announcement - MIS Alumni Portal</title>
</head>
<body>
  <h1>New Announcement</h1>
  <form method="POST" action="/announcements">
    <p>
      <label for="title">Title:</label><br>
      <input type="text" id="title" name="title" required>
    </p>
    <p>
      <label for="content">Content:</label><br>
      <textarea id="content" name="content" rows="6" cols="60" required></textarea>
    </p>
    <button type="submit">Create</button>
  </form>
  <p><a href="/announcements">All announcements</a> | <a href="/">Back</a></p>
</body>
</html>
