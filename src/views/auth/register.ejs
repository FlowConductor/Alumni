<%- include('../partials/head', { title: 'Register' }) %>
<%- include('../partials/nav', { active: 'register' }) %>

<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="/">Home</a><span>/</span>Register
</nav>

<div class="page-header">
  <div class="page-header__text">
    <span class="eyebrow">Membership</span>
    <h1>Register</h1>
    <p class="page-subtitle">
      Create your account for the MIS Alumni Portal. Every new account starts as an alumni
      member; department staff roles are assigned by an administrator.
    </p>
  </div>
</div>

<% if (errors.length > 0) { %>
  <div class="alert alert--error" role="alert">
    <% errors.forEach((error) => { %>
      <p><%= error %></p>
    <% }); %>
  </div>
<% } %>

<form class="form" method="POST" action="/register" novalidate>
  <fieldset>
    <legend>Your record</legend>

    <div class="field">
      <label for="username">Username <span class="required">(required)</span></label>
      <input type="text" id="username" name="username" value="<%= values.username %>"
             minlength="3" maxlength="100" required autocomplete="username">
      <p class="hint">
        3 to 100 characters: letters, digits, dot, underscore, or hyphen. This is how you appear
        in the alumni directory.
      </p>
    </div>

    <div class="field">
      <label for="email">Email <span class="required">(required)</span></label>
      <input type="email" id="email" name="email" value="<%= values.email %>"
             maxlength="255" required autocomplete="email">
      <p class="hint">Must be unique. Used to reach you and, later, to sign in.</p>
    </div>
  </fieldset>

  <fieldset>
    <legend>Password</legend>

    <div class="field">
      <label for="password">Password <span class="required">(required)</span></label>
      <input type="password" id="password" name="password"
             minlength="8" maxlength="200" required autocomplete="new-password">
      <p class="hint">At least 8 characters, with at least one letter and one digit.</p>
    </div>

    <div class="field">
      <label for="password_confirm">Confirm password <span class="required">(required)</span></label>
      <input type="password" id="password_confirm" name="password_confirm"
             minlength="8" maxlength="200" required autocomplete="new-password">
    </div>
  </fieldset>

  <div class="form-actions">
    <button class="btn btn--primary" type="submit">Create account</button>
    <a class="btn btn--secondary" href="/users">Cancel</a>
  </div>
</form>

<p class="form-note">
  Nothing is sent by email yet: there is no verification link and no password reset. If you lose
  the password, a department administrator removes and re-creates the record.
</p>

<%- include('../partials/footer') %>
