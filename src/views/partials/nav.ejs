<a class="skip-link" href="#main">Skip to content</a>
<div class="utility">
  <div class="utility__inner">
    <span>Istanbul University · Faculty of Economics</span>
    <span>Department of Management Information Systems</span>
  </div>
</div>
<%#
  The menu comes from src/lib/navigation.js, which filters items by role. Nothing
  here decides visibility: a link appears because the model offers it, so a page
  cannot advertise an action the guards would refuse.
%>
<header class="site-header">
  <nav class="nav" aria-label="Main">
    <a class="nav__brand" href="/">
      <span class="nav__brand-mark">MIS</span>
      Alumni Portal
    </a>
    <ul class="nav__links">
      <% nav.primary.forEach((item) => { %>
        <li><a class="nav__link <%= active === item.key ? 'is-active' : '' %>" href="<%= item.href %>"><%= item.label %></a></li>
      <% }); %>
      <% nav.manage.forEach((item) => { %>
        <li><a class="nav__link nav__link--manage <%= active === item.key ? 'is-active' : '' %>" href="<%= item.href %>"><%= item.label %></a></li>
      <% }); %>
      <% nav.utility.forEach((item) => { %>
        <li><a class="nav__link" href="<%= item.href %>"><%= item.label %></a></li>
      <% }); %>
      <% if (nav.signedIn) { %>
        <li><span class="nav__user"><%= currentUser.username %> · <%= currentUser.role %></span></li>
        <li>
          <form class="nav__form" method="POST" action="/logout">
            <button class="nav__button" type="submit">Sign out</button>
          </form>
        </li>
      <% } else { %>
        <li><a class="nav__link <%= active === 'register' ? 'is-active' : '' %>" href="/register">Register</a></li>
        <li><a class="nav__link <%= active === 'login' ? 'is-active' : '' %>" href="/login">Sign in</a></li>
      <% } %>
    </ul>
  </nav>
</header>
<main id="main" class="container">
