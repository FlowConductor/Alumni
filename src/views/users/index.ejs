<%- include('../partials/head', { title: 'Alumni directory' }) %>
<%- include('../partials/nav', { active: 'users' }) %>

<div class="page-header">
  <div class="page-header__text">
    <span class="eyebrow">Alumni directory</span>
    <h1>Graduates on record<span class="count-badge"><%= users.length %></span></h1>
    <p class="page-subtitle">
      The core tracking data the department maintains for accreditation and for staying in
      touch with its graduates.
    </p>
  </div>
  <div class="page-header__actions">
    <% if (canManage) { %>
      <a class="btn btn--primary" href="/users/new">New user</a>
    <% } %>
  </div>
</div>

<% if (registered) { %>
  <div class="alert alert--success" role="status">
    Account created for <strong><%= registered %></strong>. It was registered as an alumni
    member.
  </div>
<% } %>

<% if (users.length === 0) { %>
  <div class="empty-state">
    <p>No alumni on record yet.</p>
    <a class="btn btn--secondary" href="/users/new">Add the first user</a>
  </div>
<% } else { %>
  <div class="table-wrap">
    <table class="data">
      <caption><%= users.length %> records, ordered by id</caption>
      <thead>
        <tr>
          <th scope="col">Id</th>
          <th scope="col">Username</th>
          <th scope="col">Email</th>
          <th scope="col">Role</th>
          <th scope="col">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach((user) => { %>
          <tr>
            <td class="num"><%= user.id %></td>
            <td><a href="/users/<%= user.id %>"><%= user.username %></a></td>
            <td><a href="mailto:<%= user.email %>"><%= user.email %></a></td>
            <td><span class="pill pill--<%= user.role %>"><%= user.role %></span></td>
            <td>
              <div class="actions">
                <a class="btn btn--link" href="/users/<%= user.id %>">View</a>
                <% if (canManage) { %>
                  <a class="btn btn--link" href="/users/<%= user.id %>/edit">Edit</a>
                <% } %>
                <% if (canDelete) { %>
                  <form method="POST" action="/users/<%= user.id %>/delete"
                        onsubmit="return confirm('Delete this user? This cannot be undone.');">
                    <button class="btn btn--link btn--link-danger" type="submit">Delete</button>
                  </form>
                <% } %>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('../partials/footer') %>
