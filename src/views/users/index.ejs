<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Users - MIS Alumni Portal</title>
</head>
<body>
  <h1>Users</h1>
  <table border="1" cellpadding="6">
    <thead><tr><th>Id</th><th>Username</th><th>Email</th><th></th></tr></thead>
    <tbody>
      <% users.forEach((user) => { %>
      <tr>
        <td><%= user.id %></td>
        <td><%= user.username %></td>
        <td><%= user.email %></td>
        <td><a href="/users/<%= user.id %>">view</a></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
  <p><a href="/">Back</a></p>
</body>
</html>
