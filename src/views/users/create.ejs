<%- include('../partials/head', { title: 'New user' }) %>
<%- include('../partials/nav', { active: 'users' }) %>

<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="/users">Users</a><span>/</span>New user
</nav>

<div class="page-header">
  <div class="page-header__text">
    <h1>New user</h1>
    <p class="page-subtitle">Add a graduate to the directory. Username and email must be unique.</p>
  </div>
</div>

<form class="form" method="POST" action="/users">
  <div class="field">
    <label for="username">Username <span class="required">(required)</span></label>
    <input type="text" id="username" name="username" required autocomplete="off">
  </div>

  <div class="field">
    <label for="email">Email <span class="required">(required)</span></label>
    <input type="email" id="email" name="email" required autocomplete="off">
    <p class="hint">Used to reach the graduate. Must be unique in the directory.</p>
  </div>

  <div class="form-actions">
    <button class="btn btn--primary" type="submit">Create user</button>
    <a class="btn btn--secondary" href="/users">Cancel</a>
  </div>
</form>

<%- include('../partials/footer') %>
