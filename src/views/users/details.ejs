<%- include('../partials/head', { title: user.username }) %>
<%- include('../partials/nav', { active: 'users' }) %>

<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="/users">Alumni directory</a><span>/</span><%= user.username %>
</nav>

<div class="profile-header">
  <div class="avatar" aria-hidden="true"><%= initials(user.username) %></div>
  <div class="profile-header__text">
    <h1><%= user.username %></h1>
    <p>
      Record #<%= user.id %> · <a href="mailto:<%= user.email %>"><%= user.email %></a> ·
      <span class="pill pill--<%= user.role %>"><%= user.role %></span>
    </p>
  </div>
</div>

<div class="detail-grid">
  <div class="detail-main">
    <div class="card">
      <h2 class="card__title">Identity</h2>
      <dl class="definition-list">
        <div>
          <dt>Username</dt>
          <dd><%= user.username %></dd>
        </div>
        <div>
          <dt>Email</dt>
          <dd><a href="mailto:<%= user.email %>"><%= user.email %></a></dd>
        </div>
        <div>
          <dt>Role</dt>
          <dd><span class="pill pill--<%= user.role %>"><%= user.role %></span></dd>
        </div>
        <div>
          <dt>Record id</dt>
          <dd><%= user.id %></dd>
        </div>
      </dl>
    </div>

    <div class="card">
      <h2 class="card__title">Career history</h2>
      <p class="card__meta">
        Employers, job titles, and industries are part of the Career Services module and are not
        recorded yet. When they are, they appear here in the same record layout.
      </p>
    </div>
  </div>

  <aside class="detail-side">
    <div class="card">
      <h2 class="card__title">Actions</h2>
      <div class="card__footer">
        <a class="btn btn--primary" href="/users/<%= user.id %>/edit">Edit record</a>
        <form method="POST" action="/users/<%= user.id %>/delete"
              onsubmit="return confirm('Delete this user? This cannot be undone.');">
          <button class="btn btn--danger" type="submit">Delete</button>
        </form>
      </div>
    </div>

    <div class="card">
      <h2 class="card__title">Related records</h2>
      <dl class="definition-list">
        <div>
          <dt>Donations</dt>
          <dd><a href="/api/users/<%= user.id %>/donations">JSON</a></dd>
        </div>
        <div>
          <dt>Job postings</dt>
          <dd><a href="/api/users/<%= user.id %>/job-postings">JSON</a></dd>
        </div>
        <div>
          <dt>Applications</dt>
          <dd><a href="/api/users/<%= user.id %>/applications">JSON</a></dd>
        </div>
        <div>
          <dt>API record</dt>
          <dd><a href="/api/users/<%= user.id %>">JSON</a></dd>
        </div>
      </dl>
    </div>
  </aside>
</div>

<%- include('../partials/footer') %>
