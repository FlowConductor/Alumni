{
  "info": {
    "name": "MIS Alumni Portal - Invalid Requests",
    "description": "Invalid-request suite for the MIS Alumni Portal. Every request is expected to fail with a 4xx and a reason: validation errors (400), unknown records (404), conflicts (409), and the 404 Guardian for unmatched routes. Run the app first (docker compose up or npm start), then run this folder with the Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
