                  "});",
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  pm.collectionVariables.set('baselineUserId', pm.response.json().id);",
                  "}",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('baselineUsername', pm.response.json().username);",
                  "}"
