    {
      "name": "Applications - as an alumnus",
      "description": "Creating an application is an alumni-only action. This folder registers a fresh alumnus with a unique username (which signs them in) and keeps that session for the rest of the run.",
      "item": [
        {
          "name": "POST /register - throwaway alumnus",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responds with 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('session cookie is present', function () {",
                  "  pm.expect(pm.cookies.has('mis.sid')).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "register"
              ]
            },
            "description": "Registration signs the new account in and redirects to /users, which newman follows.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "postman.alumni-{{$timestamp}}"
                },
                {
                  "key": "email",
                  "value": "postman.alumni-{{$timestamp}}@example.com"
                },
                {
                  "key": "password",
                  "value": "postman123"
                },
                {
                  "key": "password_confirm",
                  "value": "postman123"
                }
              ]
            }
          }
        },
        {
          "name": "POST /api/applications - first application",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.request.body.update(JSON.stringify({",
                  "  job_posting_id: Number(pm.collectionVariables.get('baselinePostingId')),",
                  "  user_id: Number(pm.collectionVariables.get('baselineUserId'))",
                  "}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responds with 201\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/applications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "applications"
              ]
            },
            "description": "The guard checks the caller is an alumnus; ownership of user_id is not checked yet.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"job_posting_id\": 0,\n  \"user_id\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "POST /api/applications - duplicate application",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.request.body.update(JSON.stringify({",
                  "  job_posting_id: Number(pm.collectionVariables.get('baselinePostingId')),",
                  "  user_id: Number(pm.collectionVariables.get('baselineUserId'))",
                  "}));"
                ]
              }
            },
            {
