{
  "info": {
    "name": "MIS Alumni Portal - Authenticated Suite",
    "description": "Runs against a seeded database (node src/db/seed.js). The directory and every write route require a session, so the run signs in first: the seeder creates one administrator from SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD (defaults admin@mis-alumni.local / mis-alumni-admin). Each run creates its own baseline user and posting, so the duplicate and conflict cases are deterministic and repeatable. The applications folder registers a throwaway alumnus, because creating an application is an alumni-only action, and that session is the one used for the refusal checks at the end.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "adminEmail",
      "value": "admin@mis-alumni.local"
    },
    {
      "key": "adminPassword",
      "value": "mis-alumni-admin"
    },
    {
      "key": "baselineUserId",
      "value": ""
    },
    {
      "key": "baselinePostingId",
      "value": ""
    },
    {
      "key": "baselineUsername",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Setup - sign in",
      "description": "Must run first. Newman keeps the session cookie for the rest of the run.",
      "item": [
        {
          "name": "POST /login - administrator",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responds with 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"is signed in\", function () {",
                  "  pm.expect(pm.cookies.has('mis.sid')).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Redirects to /users, which newman follows; 200 means the sign-in succeeded.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "email",
                  "value": "{{adminEmail}}"
                },
                {
                  "key": "password",
                  "value": "{{adminPassword}}"
                }
              ]
            }
          }
        }
      ]
    },
