# MIS Alumni Portal — environment variables
# Copy this file to .env and adjust the values: cp .env.example .env

# Server port (default: 3000)
PORT=3000

# MySQL connection — used once the MySQL layer is implemented (see ddd.md).
# With docker-compose: host is "mysql" from inside the compose network,
# "localhost" from the host machine; default password is "mis_alumni_pass".
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=mis_alumni

# Session cookie signing secret — REQUIRED outside development.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Bootstrap administrator created by the seeder, so the guarded routes and the
# admin panel are reachable on a fresh database. Development values only: a real
# deployment sets its own password and never keeps this one.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@mis-alumni.local
SEED_ADMIN_PASSWORD=mis-alumni-admin
