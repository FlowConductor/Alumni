# MIS Alumni Portal — environment variables
# Copy this file to .env and adjust the values: cp .env.example .env

# Server port (default: 3000)
PORT=3000

# MySQL connection — used once the MySQL layer is implemented (see ddd.md).
# With docker-compose: host is "mysql" from inside the compose network,
# "localhost" from the host machine; default password is "mis_alumni_pass".
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=mis_alumni
